/* Interest checkbox */
.signup-row input[type="checkbox"] {
  width: 16px;
  height: 16px;
  margin: 0 4px 0 0;
  accent-color: var(--primary);
  cursor: pointer;
  vertical-align: middle;
}

/* Interest row layout */
.signup-row:has(input[type="checkbox"]) {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 12px;
}

.signup-row:has(input[type="checkbox"]) > div {
  flex: 0 0 80px;
}

/* Checkbox hover */
.signup-row input[type="checkbox"]:hover {
  filter: brightness(0.9);
}