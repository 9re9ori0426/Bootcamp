<!DOCTYPE html>
<html>
<head>
<meta charset="UTF-8">
<title>Insert title here</title>
<link rel='stylesheet' href='reg.css'>
</head>
<body>
	<form action="Reg">
		<div class="signup-row">
			<div>Name</div>
			<input name="name">
		</div>
		<div class="signup-row">
			<div>ID</div>
			<input name="id">
		</div>
		<div class="signup-row">
			<div>PW</div>
			<input type="password" name="pw">
		</div>
		<div class="signup-row">
			<div>Gender</div>
			<label>male<input type="radio" name="gender" checked value="m"></label>
			<label>female<input type="radio" name="gender" value="f"></label>
		</div>
		<div class="signup-row">
			<div>Addr</div>
			<select name="addr">
				<option>Seoul</option>
				<option>Busan</option>
				<option>Cheonan</option>
				<option >Seongbukgu</option>
				<option selected>Hanam</option>
			</select>
		</div>
		<div class="signup-row">
			<div>Interest</div>
			<label><input type="checkbox" name="interest" value="food">Food</label>
			<label><input type="checkbox" name="interest" value="exer">Excer</label>
			<label><input type="checkbox" name="interest" value="develop">Develop</label>
			<label><input type="checkbox" name="interest" value="travel">Travel</label>
		</div>
		<div class="signup-row">
			<div>Introduce</div>
			<textarea name="introduce"></textarea>
		</div>


		<button>sign up</button>
	</form>
</body>
</html>